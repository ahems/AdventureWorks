{
  "name": "AdventureWorks",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "lfs": true
    },
    "ghcr.io/azure/azure-dev/azd:latest": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "ms-vscode.powershell",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright"
      ],
      "settings": {
        // PowerShell settings
        "powershell.powerShellAdditionalExePaths": {
          "PowerShell (x64)": "/usr/bin/pwsh"
        },
        "powershell.powerShellDefaultVersion": "PowerShell (x64)",
        "powershell.enableStartUpBanner": false,

        // Format settings
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "containerEnv": {
    "AZD_SKIP_FIRST_RUN": "true"
  },
  "postCreateCommand": "git lfs pull || true && az bicep install && npm ci && npx playwright install --with-deps chromium && (cd app && npm ci) && (cd app-admin && npm ci) && (cd app-manufacturing && npm ci) && npm install --prefix app @playwright/test csv-parse && dotnet restore api-functions/api-functions.csproj && dotnet restore api-mcp/ServiceDefaults/ServiceDefaults.csproj && dotnet restore api-mcp/AppHost/AppHost.csproj",
  "hostRequirements": {
    "memory": "8gb"
  }
}
