FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /config

RUN dotnet new tool-manifest

# Keep the CLI and runtime image on the same Data API builder release.
ARG DAB_VERSION=2.1.7

RUN dotnet tool install Microsoft.DataApiBuilder --version ${DAB_VERSION}

# Cache-bust: update this string when dab-config.json changes to force layer rebuild
RUN echo "dab-config-v10-2026-11-22-production-review-votes" > /dev/null

# Copy the pre-configured dab-config.json file
COPY dab-config.json .

FROM mcr.microsoft.com/azure-databases/data-api-builder:2.1.7

COPY --from=build /config /App

# Add startup wrapper that waits for Managed Identity token availability
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Optional tuning via env vars
# MI_RESOURCE: resource URL for token acquisition (default: https://database.windows.net)
# MI_INITIAL_DELAY_SECONDS, MI_PERIOD_SECONDS, MI_FAILURE_THRESHOLD to control MI wait behavior
# DB_INITIAL_DELAY_SECONDS: Initial delay before the first DAB start
# DB_RETRY_INITIAL_SECONDS / DB_RETRY_MAX_SECONDS: exponential backoff between DAB start attempts
# DB_START_DEADLINE_SECONDS: stop retrying and exit non-zero after this long (keep below the startup probe window)
ENV MI_RESOURCE="https://database.windows.net" \
	MI_INITIAL_DELAY_SECONDS="0" \
	MI_PERIOD_SECONDS="1" \
	MI_FAILURE_THRESHOLD="60" \
	DB_INITIAL_DELAY_SECONDS="0" \
	DB_RETRY_INITIAL_SECONDS="5" \
	DB_RETRY_MAX_SECONDS="40" \
	DB_START_DEADLINE_SECONDS="150" \
	ASPNETCORE_URLS="http://+:80"

ENTRYPOINT ["/entrypoint.sh"]