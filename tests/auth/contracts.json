    "roleDefinitionId": "09976791-48a7-449e-bb21-39d1a415f350",
    "roleName": "Communication and Email Service Owner",
    "allowedActionPrefixes": ["Microsoft.Communication/"],
    "justification": "Built-in role used because deployment users cannot safely receive roleDefinitions/write. This is broader than the former custom role: at the selected Communication resource it permits resource and email-service management, deletion, and key retrieval/regeneration. Keep the assignment resource-scoped and review changes to the built-in role."
  },
  "runtimeWebPubSubRole": {
    "roleDefinitionId": "12cf5a90-567b-43ae-8102-96cf46c7d9b4",
    "roleName": "Web PubSub Service Owner",
    "dataActions": ["Microsoft.SignalRService/WebPubSub/*"],
    "justification": "Built-in role used because deployment users cannot safely receive roleDefinitions/write. It grants all Web PubSub data actions (including closing connections and managing group/user permissions) instead of the former four-action custom role. It has no management actions, so it cannot read keys or re-enable local auth. Group grants remain server-selected from signed token scopes."
  },
  "runtimeFoundryDataRole": {
    "roleDefinitionId": "19c28022-e58e-450d-a464-0b2a53034789",
    "roleName": "Cognitive Services Data Contributor (Preview)",
    "dataActions": ["Microsoft.CognitiveServices/*"],
    "justification": "Built-in preview role used because deployment users cannot safely receive roleDefinitions/write. It grants all Cognitive Services data actions at the Foundry project scope, broader than the former AIServices/* custom role, but no management actions, so no key retrieval or account changes. Agent business access remains bounded by OAuth-delegated MCP/API tokens and tool policies."
  },
